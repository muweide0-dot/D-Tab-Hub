-async function sortTierRoles(guildId: string, botUserId: string) {
-  const [roles, botMemberResponse] = await Promise.all([
-    getGuildRoles(guildId),
-    rest(`/guilds/${guildId}/members/${botUserId}`),
-  ]);
-  if (!botMemberResponse.ok) {
-    throw new Error(`Could not read the bot's role hierarchy: ${botMemberResponse.status}`);
-  }
-
-  const botMember = (await botMemberResponse.json()) as DiscordGuildMember;
-  const botRolePositions = roles
-    .filter((role) => botMember.roles?.includes(role.id) && typeof role.position === "number")
-    .map((role) => role.position as number);
-  if (botRolePositions.length === 0) {
-    throw new Error("Could not determine the bot's highest server role.");
-  }
-  const botHighestRolePosition = Math.max(...botRolePositions);
-
-  const tierRoles = roles.flatMap((role) => {
-    const match = role.name.trim().match(/^\[?(ht[1-5]|lt[1-5])\]?(?=\s|$)/i);
-    return match
-      ? [{ role, tier: match[1].toLowerCase() as (typeof TIER_ROLE_SORT_ORDER)[number] }]
-      : [];
-  });
-  const sortableRoles = tierRoles
-    .filter(
-      ({ role }) =>
-        !role.managed &&
-        role.id !== guildId &&
-        typeof role.position === "number" &&
-        role.position < botHighestRolePosition,
-    )
-    .sort(
-      (a, b) =>
-        TIER_ROLE_SORT_ORDER.indexOf(a.tier) - TIER_ROLE_SORT_ORDER.indexOf(b.tier) ||
-        a.role.name.toLowerCase().localeCompare(b.role.name.toLowerCase()) ||
-        a.role.id.localeCompare(b.role.id),
-    );
-
-  const updates = sortableRoles.map(({ role }, index) => ({
-    id: role.id,
-    position: botHighestRolePosition - index - 1,
-  }));
-  const changedUpdates = updates.filter(
-    (update) => roles.find((role) => role.id === update.id)?.position !== update.position,
-  );
-  if (changedUpdates.length > 0) {
-    const response = await rest(`/guilds/${guildId}/roles`, {
-      method: "PATCH",
-      body: JSON.stringify(changedUpdates),
-    });
-    if (!response.ok) {
-      throw new Error(`Could not sort tier roles: ${response.status} ${await response.text()}`);
-    }
-  }
-
-  return {
-    found: tierRoles.length,
-    sorted: sortableRoles.length,
-    skipped: tierRoles.length - sortableRoles.length,
-  };
-}
